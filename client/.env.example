# Leave unset on the website: Vercel proxies /api to the API (vercel.json).
# The native app can't use that proxy, so its build sets the API's address.
# VITE_API_URL=https://midpoint-api-production.up.railway.app

# Login via Supabase Auth. Both come from Project Settings > API in Supabase.
# The anon key is public by design. Required for the native app; optional on
# the website until you switch it over (see MOBILE.md).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=
